# Proxy HTTPS. Em rede interna da UEPG, "tls internal" usa uma autoridade certificadora
# própria do Caddy; com domínio público, remova essa linha para usar Let's Encrypt.
{$DOMINIO} {
	tls internal
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# só recursos do próprio servidor; nada de scripts embutidos ou de terceiros
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; media-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		# o microfone é usado pelo ditado; câmera e localização, nunca
		Permissions-Policy "microphone=(self), camera=(), geolocation=(), payment=()"
		-Server
	}

	handle_path /api/* {
		reverse_proxy api:3333
	}

	# interface web (aplicação de página única): rotas desconhecidas voltam para o index.html
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
