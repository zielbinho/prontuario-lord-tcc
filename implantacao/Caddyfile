{
	servers {
		# só HTTP/1.1 e HTTP/2: sem o anúncio de HTTP/3 (Alt-Svc), que também identificava o servidor
		protocols h1 h2
	}
}

# Proxy HTTPS. MODO_TLS=interno (padrão): certificado de uma autoridade própria do Caddy,
# para a rede interna da UEPG. MODO_TLS=publico: certificado da Let's Encrypt, para um domínio
# acessível pela internet (as portas 80 e 443 precisam estar abertas).
(tls-interno) {
	tls internal
}
(tls-publico) {
}

# Cabeçalhos de segurança. Ficam num trecho à parte porque também precisam valer nas respostas
# de erro: o Caddy descarta os cabeçalhos do site ao tratar um erro (a varredura do OWASP ZAP
# identificou o servidor pelas respostas 405 a TRACE e OPTIONS, que saíam sem eles).
(cabecalhos) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# só recursos do próprio servidor; nada de scripts embutidos ou de terceiros
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; media-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Frame-Options "DENY"
		# isolamento entre origens: nenhuma página de terceiros compartilha contexto com o sistema
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Embedder-Policy "require-corp"
		Cross-Origin-Resource-Policy "same-origin"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		# o microfone é usado pelo ditado; câmera e localização, nunca
		Permissions-Policy "microphone=(self), camera=(), geolocation=(), payment=()"
		-Server
		-Alt-Svc
		# o proxy reverso acrescenta "Via: 1.1 Caddy", que também identificava o servidor
		-Via
	}
}

# Redirecionamento de HTTP para HTTPS declarado aqui, e não o automático do Caddy, que
# identificava o servidor. A validação da Let's Encrypt pela porta 80 continua funcionando.
http://{$DOMINIO} {
	header -Server
	redir https://{host}{uri} 308
}

{$DOMINIO} {
	import tls-{$MODO_TLS:interno}
	import cabecalhos
	encode gzip

	# TRACE, TRACK e OPTIONS não são usados pelo sistema: a resposta é a mesma em qualquer caminho,
	# para que a API atrás do proxy não responda diferente das páginas (o que revelaria o proxy)
	@metodos_diagnostico method TRACE TRACK OPTIONS
	handle @metodos_diagnostico {
		respond 405
	}

	handle_path /api/* {
		reverse_proxy api:3333
	}

	# interface web (aplicação de página única): rotas desconhecidas voltam para o index.html
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	handle_errors {
		import cabecalhos
		respond "{err.status_code} {err.status_text}"
	}
}
