# Proxy HTTPS (Caddy) que também serve a interface web já compilada.
# Construir a partir da RAIZ do repositório:  docker compose build proxy
FROM node:22-alpine AS interface

WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/ficha/package.json packages/ficha/
COPY packages/ia/package.json packages/ia/
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
RUN npm ci --workspace @lord/web --include-workspace-root=false

COPY packages/ficha packages/ficha
COPY apps/web apps/web
RUN npm run build -w @lord/web

FROM caddy:2
COPY implantacao/Caddyfile /etc/caddy/Caddyfile
COPY --from=interface /app/apps/web/dist /srv
