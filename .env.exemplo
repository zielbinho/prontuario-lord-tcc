# Copie para .env no servidor e preencha. O arquivo .env NUNCA vai para o git.
# Gere cada segredo com:  openssl rand -hex 32

# Endereço pelo qual a clínica acessa o sistema (ex.: prontuario-lord.uepg.br ou o IP interno)
DOMINIO=

# interno (rede da UEPG, certificado próprio do Caddy) ou publico (domínio na internet, Let's Encrypt)
MODO_TLS=interno

# Dono das tabelas (usado apenas para migrações)
SENHA_DONO=

# Papel da API (sujeito a Row-Level Security) e papel do serviço analítico
SENHA_PAPEL_APP=
SENHA_PAPEL_ANALITICO=

# Chave dos dados pessoais cifrados (CPF, RG, telefone, endereço).
# Guarde uma cópia em local seguro: sem ela, esses dados ficam irrecuperáveis.
CHAVE_CRIPTOGRAFIA=

# Segredo dos pseudônimos do esquema analítico. Não troque depois de definido.
SEGREDO_PSEUDONIMO=

# Modelos (opcional): modelo de linguagem do Ollama e tamanho do Whisper
MODELO_IA=qwen2.5:3b
MODELO_WHISPER=small
